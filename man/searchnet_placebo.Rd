panel$treated     <- as.integer(tr)
panel$first_treat <- ifelse(tr, 6L, 0L)
panel$outcome <- 0.2 * panel$step + rnorm(nrow(panel)) +
  ifelse(tr & panel$step >= 6, 1.5, 0)
pl <- searchnet_placebo(panel, estimator = "did_2x2", n_draws = 99, seed = 1)
